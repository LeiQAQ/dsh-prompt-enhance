# Copy these values into the Windows user environment or a local .env.local.
# Never put a real API key in this file.
PROMPT_ENHANCE_ENDPOINT=https://api.deepseek.com/chat/completions
PROMPT_ENHANCE_MODEL=deepseek-chat
PROMPT_ENHANCE_API_KEY=
PROMPT_ENHANCE_CDP_URL=http://127.0.0.1:9222
PROMPT_ENHANCE_PORT=18765
PROMPT_ENHANCE_TIMEOUT_MS=120000
