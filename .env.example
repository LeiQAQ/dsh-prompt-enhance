# Export these values in the adapter process environment.
# The launcher does not automatically load .env or .env.local files.
# Never put a real API key in this file.
PROMPT_ENHANCE_ENDPOINT=https://api.deepseek.com/chat/completions
PROMPT_ENHANCE_MODEL=deepseek-flash
# The Codex Desktop launcher currently does not expose a thinking toggle.
# Use the T3 DeepSeek route or the provider factory for explicit thinking: disabled.
PROMPT_ENHANCE_API_KEY=
PROMPT_ENHANCE_CDP_URL=http://127.0.0.1:9222
PROMPT_ENHANCE_PORT=18765
PROMPT_ENHANCE_TIMEOUT_MS=120000
