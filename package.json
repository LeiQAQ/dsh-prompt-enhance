{
  "name": "dsh-prompt-enhance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enhance-prompt button for the dsh composer: rewrite the draft into a high-quality prompt with one model call.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./core": "./dist/core/enhance.js",
    "./providers/openai-compatible": "./dist/providers/openai-compatible.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml",
    "dist",
    "plugins",
    "scripts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prompts": "node scripts/gen-prompts.mjs",
    "verify:prompts": "node scripts/verify-prompts.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:roster": "node scripts/verify-profile-roster.mjs",
    "check:restart": "node scripts/check-desktop-restart.mjs",
    "adapter:codex": "node scripts/codex-desktop-adapter.mjs",
    "adapter:codex:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-codex-adapter.ps1",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify-prompts.mjs && node scripts/build.mjs && node --test \"tests/**/*.test.mjs\" && node scripts/verify-install.mjs && node scripts/verify-profile-roster.mjs"
  }
}
